# Token del bot de Telegram (BotFather)
TELEGRAM_BOT_TOKEN=

# Chat al que se envía el resumen. Si se deja vacío, el bot lo detecta
# solo a partir del último mensaje que le hayas escrito (envíale /start).
TELEGRAM_CHAT_ID=

# Opcional: con una API key de Anthropic el resumen lo redacta Claude.
# Sin ella, se envía una lista de titulares agrupada por medio.
ANTHROPIC_API_KEY=

# Ventana de noticias y frecuencia del bucle, en minutos
VENTANA_MINUTOS=60
INTERVALO_MINUTOS=60
